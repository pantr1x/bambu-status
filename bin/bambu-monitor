#!/usr/bin/env python3
"""Bambu Lab printer LAN monitor.

Holds an MQTT-over-TLS connection to the printer and writes the current print
state to a status file for the UI (Plasma applet on Linux, the tray widget on
Windows) to read.

Implements just enough of MQTT 3.1.1 (CONNECT / SUBSCRIBE / PUBLISH / PINGREQ)
to avoid a paho-mqtt dependency, which would need root to install.

Config:
    Linux    ~/.config/bambu-monitor.json
    Windows  %APPDATA%\\BambuStatus\\config.json
    {"host": "...", "serial": "...", "accessCode": "...", "model": "P1S"}

The Windows widget imports this module and runs serve() on a thread, so
everything below has to stay importable and free of side effects.
"""

import json
import os
import re
import base64
import socket
import ssl
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor
import struct
import sys
import threading
import time
from pathlib import Path

APP_DIR_NAME = "BambuStatus"


def config_path():
    """Where the printer credentials live."""
    override = os.environ.get("BAMBU_MONITOR_CONFIG")
    if override:
        return Path(override)
    if os.name == "nt":
        base = os.environ.get("APPDATA") or Path.home() / "AppData" / "Roaming"
        return Path(base) / APP_DIR_NAME / "config.json"
    return Path.home() / ".config" / "bambu-monitor.json"


def state_dir():
    """Where the monitor and the UI exchange status, commands and frames."""
    override = os.environ.get("BAMBU_STATUS_DIR")
    if override:
        return Path(override)
    if os.name == "nt":
        base = os.environ.get("LOCALAPPDATA") or Path.home() / "AppData" / "Local"
        return Path(base) / APP_DIR_NAME
    return Path.home() / ".cache"


CONF = config_path()
DIR = state_dir()
OUT = DIR / "bambu-status.json"
CMD = DIR / "bambu-command"      # the UI drops a verb here
FRAME = DIR / "bambu-frame.jpg"  # latest camera frame
LOCK = DIR / ".bambu-monitor.lock"
PORT = 8883
CAM_PORT = 6000
KEEPALIVE = 60

# only these may be sent to the printer; anything else in the command file is
# ignored rather than forwarded
ALLOWED_COMMANDS = ("pause", "resume", "stop", "reprint")

# which transport is carrying the current connection, so the UI can say why
# there is no camera when the printer is being watched through the account
ACTIVE_MODE = "lan"


# ---------------------------------------------------------------- MQTT bits
def rlen(n):
    """Encode MQTT remaining-length varint."""
    out = b""
    while True:
        b = n % 128
        n //= 128
        out += bytes([b | (0x80 if n else 0)])
        if not n:
            return out


def mstr(s):
    b = s.encode("utf-8")
    return struct.pack(">H", len(b)) + b


def connect_packet(client_id, user, password):
    vh = mstr("MQTT") + bytes([4, 0xC2]) + struct.pack(">H", KEEPALIVE)
    payload = mstr(client_id) + mstr(user) + mstr(password)
    body = vh + payload
    return bytes([0x10]) + rlen(len(body)) + body


def subscribe_packet(topic, pid=1):
    body = struct.pack(">H", pid) + mstr(topic) + bytes([0])
    return bytes([0x82]) + rlen(len(body)) + body


def publish_packet(topic, payload):
    body = mstr(topic) + payload.encode("utf-8")
    return bytes([0x30]) + rlen(len(body)) + body


def read_rlen(sock):
    mult, value = 1, 0
    while True:
        b = sock.recv(1)
        if not b:
            raise ConnectionError("connection closed")
        value += (b[0] & 127) * mult
        if not (b[0] & 128):
            return value
        mult *= 128
        if mult > 128 ** 3:
            raise ValueError("bad remaining length")


def recv_exact(sock, n):
    buf = b""
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            raise ConnectionError("connection closed")
        buf += chunk
    return buf


# ---------------------------------------------------------------- state
# Bambu encodes the model in the serial prefix. The user-visible device name is
# only known to the cloud account, and the printer does not answer SSDP in LAN
# mode, so this is the most specific name obtainable offline.
SERIAL_MODELS = {
    "00M": "X1C", "00W": "X1", "03W": "X1E",
    "01S": "P1P", "01P": "P1S",
    "030": "A1 mini", "039": "A1",
    "094": "H2D",
}


def model_from_serial(serial):
    return SERIAL_MODELS.get(serial[:3], "Bambu")


STATE_LABELS = {
    "RUNNING": "Printing",
    "PAUSE": "Paused",
    "FINISH": "Done",
    "FAILED": "Failed",
    "IDLE": "Idle",
    "PREPARE": "Preparing",
    "SLICING": "Slicing",
}


def clean_name(raw):
    if not raw:
        return ""
    name = os.path.basename(raw)
    for ext in (".gcode.3mf", ".3mf", ".gcode"):
        if name.lower().endswith(ext):
            name = name[: -len(ext)]
            break
    return name.replace("_", " ").strip()


def atomic_replace(tmp, dst, tries=4):
    """Windows refuses to replace a file a reader still has open, and the UI
    reads these files every second, so retry briefly instead of dying."""
    for attempt in range(tries):
        try:
            tmp.replace(dst)
            return True
        except OSError:
            if attempt == tries - 1:
                try:
                    tmp.unlink()
                except OSError:
                    pass
                return False
            time.sleep(0.05)


def write_state(d, connected=True, error=""):
    OUT.parent.mkdir(parents=True, exist_ok=True)
    # per-pid temp file: two instances racing on one temp name make the rename
    # fail with FileNotFoundError
    tmp = OUT.with_name(f".{OUT.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(d | {"connected": connected, "error": error,
                                   "mode": ACTIVE_MODE,
                                   "updated": int(time.time())}),
                   encoding="utf-8")
    atomic_replace(tmp, OUT)


def snapshot(p, model):
    """Extract the fields the applet needs from a print report."""
    state = (p.get("gcode_state") or "").upper()
    pct = p.get("mc_percent")
    remain = p.get("mc_remaining_time")
    name = clean_name(p.get("subtask_name") or p.get("gcode_file"))
    layer, total = p.get("layer_num"), p.get("total_layer_num")
    return {
        "name": name,
        "state": state,
        "label": STATE_LABELS.get(state, state.title() or "—"),
        "percent": int(pct) if isinstance(pct, (int, float)) else 0,
        "remainingMin": int(remain) if isinstance(remain, (int, float)) else 0,
        "layer": int(layer) if isinstance(layer, (int, float)) else 0,
        "totalLayers": int(total) if isinstance(total, (int, float)) else 0,
        "nozzle": p.get("nozzle_temper"),
        "bed": p.get("bed_temper"),
        "model": model,
        "gcodeFile": p.get("gcode_file") or "",
        "printing": state in ("RUNNING", "PAUSE", "PREPARE"),
    }


PLACEHOLDERS = {"192.168.0.000", "PUT-YOUR-SERIAL-HERE", "00000000", "", None}


def config_problem(conf):
    """Say what is still missing, in words worth showing a user.

    Without this the template config just produces a DNS error, which explains
    nothing to somebody who has not filled the file in yet."""
    if not isinstance(conf, dict):
        return "config is not a JSON object"

    serial = str(conf.get("serial", "")).strip()
    # a cloud config asks for different things: the account stands in for the
    # address and the access code, neither of which reaches off the LAN anyway
    if str(conf.get("mode") or "").lower() == "cloud" or (
            conf.get("token") and not conf.get("host")):
        if not looks_like_serial(serial):
            return "that serial does not look like a printer's"
        if not str(conf.get("token") or "").strip():
            return ("no Bambu account token — sign in to Bambu Studio, or use "
                    "the printer's own address instead")
        return None

    missing = [k for k in ("host", "serial", "accessCode")
               if str(conf.get(k, "")).strip() in PLACEHOLDERS]
    if missing:
        return ("still the example config — fill in "
                + ", ".join(missing)
                + " (printer screen: Settings → WLAN)")
    if not plausible_host(conf.get("host")):
        return f"{conf.get('host')!r} is not an address a printer could be at"
    if not plausible_code(conf.get("accessCode")):
        return ("the access code should be the eight characters the printer "
                "shows under Settings → WLAN")
    if not looks_like_serial(str(conf.get("serial", "")).strip()):
        return "that serial does not look like a printer's"
    return None


# ---------------------------------------------------------------- discovery
# In LAN mode the printer broadcasts an SSDP NOTIFY every few seconds. It
# carries the address, the serial and the model — everything except the access
# code, which is a secret and only ever shown on the printer's own screen.
SSDP_GROUP = "239.255.255.250"
SSDP_PORTS = (2021, 1990)


def parse_ssdp(text):
    """Pull the bambu fields out of one NOTIFY datagram."""
    if "bambulab" not in text.lower():
        return None
    head = {}
    for line in text.splitlines()[1:]:
        if ":" in line:
            k, _, v = line.partition(":")
            head[k.strip().lower()] = v.strip()
    host = head.get("location", "")
    serial = head.get("usn", "")
    if not host or not serial:
        return None
    return {"host": host,
            "serial": serial,
            "name": head.get("devname.bambu.com", ""),
            "model": model_from_serial(serial)}


def discover(timeout=6.0):
    """Listen for printers announcing themselves. Returns a list, newest last."""
    socks = []
    for port in SSDP_PORTS:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            s.bind(("", port))
        except OSError:
            s.close()
            continue
        try:                            # listen to the group as well as broadcast
            s.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP,
                         socket.inet_aton(SSDP_GROUP) + socket.inet_aton("0.0.0.0"))
        except OSError:
            pass
        s.settimeout(0.5)
        socks.append(s)
    if not socks:
        return []

    # most firmware answers an M-SEARCH, and all of it announces unprompted
    probe = ("M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1990\r\n"
             'MAN: "ssdp:discover"\r\nMX: 1\r\n'
             "ST: urn:bambulab-com:device:3dprinter:1\r\n\r\n").encode()
    for s in socks:
        try:
            s.sendto(probe, (SSDP_GROUP, 1990))
        except OSError:
            pass

    found = {}
    end = time.time() + timeout
    while time.time() < end:
        for s in socks:
            try:
                data, addr = s.recvfrom(4096)
            except (socket.timeout, OSError):
                continue
            info = parse_ssdp(data.decode("utf-8", "replace"))
            if info:
                # the datagram's own source address beats a Location header
                # that some firmware fills in with a stale lease
                info.setdefault("host", addr[0])
                found[info["serial"]] = info
    for s in socks:
        s.close()
    return list(found.values())


def local_subnets():
    """The /24 this machine sits on, per interface, without asking the OS for
    an interface list it does not portably have."""
    nets = set()
    for family, kind in ((socket.AF_INET, socket.SOCK_DGRAM),):
        s = socket.socket(family, kind)
        try:
            s.connect(("192.168.1.1", 9))   # no packet leaves, it just routes
            ip = s.getsockname()[0]
            if plausible_host(ip):
                nets.add(ip.rsplit(".", 1)[0])
        except OSError:
            pass
        finally:
            s.close()
    try:
        for info in socket.getaddrinfo(socket.gethostname(), None, socket.AF_INET):
            ip = info[4][0]
            if plausible_host(ip):
                nets.add(ip.rsplit(".", 1)[0])
    except OSError:
        pass
    return sorted(nets)


def port_open(host, port=PORT, timeout=0.6):
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def scan_lan(hosts=None, workers=64, timeout=0.6):
    """Every address on the local networks with the printer's MQTT port open.

    This is the fallback for a printer that never announces itself — a firewall
    eating the broadcast, or a network that does not pass multicast."""
    if hosts is None:
        hosts = [f"{net}.{i}" for net in local_subnets() for i in range(1, 255)]
    if not hosts:
        return []
    found = []
    with ThreadPoolExecutor(max_workers=workers) as pool:
        for host, is_open in zip(hosts, pool.map(
                lambda h: port_open(h, PORT, timeout), hosts)):
            if is_open:
                found.append(host)
    return found


def accepts(host, code, timeout=5):
    """Does this address answer to that access code? Confirms both at once."""
    try:
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        raw = socket.create_connection((host, PORT), timeout=timeout)
        sock = ctx.wrap_socket(raw, server_hostname=host)
        sock.settimeout(timeout)
        try:
            sock.sendall(connect_packet(f"probe-{os.getpid()}", "bblp", code))
            hdr = recv_exact(sock, 1)
            n = read_rlen(sock)
            body = recv_exact(sock, n)
            return hdr[0] >> 4 == 2 and len(body) > 1 and body[1] == 0
        finally:
            sock.close()
    except OSError:
        return False


# Bambu Studio and OrcaSlicer remember every printer they have talked to —
# address, serial and access code — so the details can be picked up off this
# machine without waiting for the printer to announce itself. The layout of
# those files has moved around between releases, so rather than pin one schema
# this walks the config tree for anything that looks like a saved printer.
SLICER_DIRS = ("BambuStudio", "OrcaSlicer", "BambuNetworkEngine",
               "bambu-studio", "OrcaSlicer-nightly", "Bambu Studio",
               "BambuNetworkPlugin", "Bambu Network Plugin", "bambustudio")
# Field names vary by release and by fork, so keep the net wide. What stops
# this from picking up nonsense is not the names — it is the rule in _record()
# that the same object must also carry something shaped like a Bambu serial.
CODE_KEYS = ("access_code", "accesscode", "access-code", "dev_access_code",
             "printer_access_code", "lan_access_code", "lan_code", "passcode",
             "pass_code", "printer_code", "device_code", "code")
ID_KEYS = ("dev_id", "device_id", "serial", "serial_number", "sn", "usn",
           "printer_sn", "dev_sn", "printer_id", "machine_id", "dev_serial")
IP_KEYS = ("dev_ip", "ip", "host", "hostname", "printer_ip", "dev_address",
           "lan_ip", "ip_address", "addr", "address", "device_ip")
NAME_KEYS = ("dev_name", "device_name", "printer_name", "dev_alias", "alias",
             "nickname", "machine_name", "name")
# "name" is only safe in that list because a record must carry a serial to
# qualify at all — which every preset in a slicer's library lacks


def slicer_config_dirs():
    homes = []
    if os.name == "nt":
        for var in ("APPDATA", "LOCALAPPDATA"):
            base = os.environ.get(var)
            if base:
                homes.append(Path(base))
    else:
        homes += [Path.home() / ".config", Path.home()]
    found, seen = [], set()
    for home in homes:
        for name in SLICER_DIRS:
            path = home / name
            if not path.is_dir():
                continue
            key = str(path.resolve()).lower()   # Windows paths are caseless
            if key not in seen:
                seen.add(key)
                found.append(path)
    return found


def plausible_host(host):
    """A LAN address a printer could actually be at."""
    host = str(host or "").strip()
    if not host or host in PLACEHOLDERS:
        return False
    if IPV4_RE.fullmatch(host):
        try:
            octets = [int(o) for o in host.split(".")]
        except ValueError:
            return False
        if len(octets) != 4 or any(not 0 <= o <= 255 for o in octets):
            return False
        # 0.x, link-local and broadcast are never a printer. Loopback is:
        # reaching it down an SSH tunnel is a real thing people do.
        return not (octets[0] in (0, 255) or octets[:2] == [169, 254])
    # a hostname, then: something resolvable-looking rather than punctuation
    return (3 <= len(host) <= 253
            and all(c.isalnum() or c in "-." for c in host)
            and any(c.isalnum() for c in host))


def plausible_code(code):
    """Bambu access codes are eight alphanumeric characters."""
    code = str(code or "").strip()
    return len(code) == 8 and code.isalnum() and code != "00000000"


def looks_like_serial(key):
    """Some layouts key printers by serial rather than naming the field."""
    k = str(key)
    return (10 <= len(k) <= 24 and k.isalnum() and k == k.upper()
            and any(c.isdigit() for c in k) and any(c.isalpha() for c in k))


def _flat(node):
    return {str(k).lower(): str(v).strip()
            for k, v in node.items() if isinstance(v, (str, int, float))}


def _record(node, key_serial=None):
    """What this dict holds, if it looks like a saved printer.

    A serial alone is not enough — "name" and "model" appear all over a slicer's
    presets — so it has to carry an access code or an address as well."""
    flat = _flat(node)
    # a config root is not a device record: reading one as though it were is how
    # an address of 00.00.00.00 and a one-character access code got in
    if len(flat) > 40:
        return None

    def first(keys):
        return next((flat[k] for k in keys if flat.get(k)), "")

    # a serial gives itself away by its shape, so where the field names are ones
    # nobody has seen, go by that — but only in an object small enough to be
    # about a single device
    serial = first(ID_KEYS) or key_serial or ""
    if not looks_like_serial(serial) and len(flat) <= 12:
        serial = next((v for v in flat.values() if SERIAL_RE.fullmatch(v)), "")
    if not looks_like_serial(serial):
        return None

    # never carry a value forward that cannot be what it claims to be. Guessing
    # at a credential is worse than leaving it empty and saying so.
    code = first(CODE_KEYS)
    code = code if plausible_code(code) else ""
    host = first(IP_KEYS)
    if not plausible_host(host):
        host = next((v for v in flat.values()
                     if IPV4_RE.fullmatch(v) and plausible_host(v)), "")
    if not code and not host:
        return None
    return {"serial": serial, "accessCode": code, "host": host,
            "name": first(NAME_KEYS), "model": model_from_serial(serial)}


def _walk(node, out, key_serial=None):
    if isinstance(node, dict):
        found = _record(node, key_serial)
        if found:
            kept = out.setdefault(found["serial"], found)
            for field in ("accessCode", "host", "name"):
                if not kept.get(field) and found.get(field):
                    kept[field] = found[field]      # often split across files
        for key, value in node.items():
            _walk(value, out, key if looks_like_serial(key) else key_serial)
    elif isinstance(node, list):
        for item in node:
            _walk(item, out, key_serial)


# A Bambu serial always starts with one of the model prefixes, which makes it
# findable in a file whose key names mean nothing to us.
SERIAL_RE = re.compile(
    r"\b(?:" + "|".join(SERIAL_MODELS) + r")[0-9A-Z]{9,17}\b")
IPV4_RE = re.compile(r"(?:\d{1,3}\.){3}\d{1,3}")

# a slicer install is mostly vendor presets and an embedded browser's cache;
# neither has ever held a device record, and there are thousands of them
SKIP_PARTS = {"webview2cache", "cache", "caches", "logs", "log", "crashreports",
              "temp", "tmp", "gcodes", "shapes", "resources", "profiles"}
# cheap pre-filter: a file with none of these bytes cannot hold a device record
MARKERS = (b"access_code", b"accesscode", b"dev_id", b"dev_ip", b"dev_name",
           b"printer_sn", b"device_id")
# The vendor preset library lives under these — several thousand files on a
# stock Bambu Studio install, and not one of them has ever held a device
# record. Left in name order they come before "user", so reading alphabetically
# spends the whole budget on filament profiles and never reaches the printer
# the user actually owns. Read last, and only a few hundred of them.
LATE_PARTS = {"system", "vendor", "presets", "hints"}


def _scan_order(rel):
    """The user's own files first, the vendor library last."""
    parts = [part.lower() for part in rel.parts]
    return (any(part in LATE_PARTS for part in parts[:-1]),
            len(parts), str(rel).lower())


def slicer_files(root, limit_bytes=4_000_000, limit=1200, late_limit=400):
    try:
        # only the parts below the slicer directory: the path above it belongs
        # to the user and may well contain a word like "tmp"
        found = [(path.relative_to(root), path) for path in root.rglob("*")]
    except OSError:
        return
    found.sort(key=lambda pair: _scan_order(pair[0]))
    seen = late = 0
    for rel, path in found:
        if seen >= limit:
            return
        parts = [part.lower() for part in rel.parts]
        if any(part in SKIP_PARTS for part in parts):
            continue
        if path.suffix.lower() not in ("", ".json", ".conf", ".cfg", ".ini",
                                       ".dat", ".txt", ".config"):
            continue
        deferred = any(part in LATE_PARTS for part in parts[:-1])
        if deferred and late >= late_limit:
            continue
        try:
            if not path.is_file() or path.stat().st_size > limit_bytes:
                continue
            blob = path.read_bytes()
        except OSError:
            continue
        seen += 1
        if deferred:
            late += 1
        low = blob.lower()
        if any(m in low for m in MARKERS):
            yield path, blob
        elif SERIAL_RE.search(blob.decode("utf-8", "replace")):
            # unknown field names, but something in here is a Bambu serial
            yield path, blob


def _scan_text(blob, out):
    """A store that is not JSON — an INI, a plain key/value list. Take the
    fields around each serial and treat them as one record."""
    text = blob.decode("utf-8", "replace")
    pairs = {}
    for line in text.splitlines():
        for sep in ("=", ":"):
            if sep in line:
                key, _, value = line.partition(sep)
                key, value = key.strip().strip('"').lower(), value.strip().strip('",')
                if key and value:
                    pairs.setdefault(key, value)
                break
    found = _record(pairs)
    if found:
        kept = out.setdefault(found["serial"], found)
        for field in ("accessCode", "host", "name"):
            if not kept.get(field) and found.get(field):
                kept[field] = found[field]


def slicer_printers():
    """Printers the installed slicer has saved, no network involved."""
    out = {}
    for root in slicer_config_dirs():
        for path, blob in slicer_files(root):
            try:
                _walk(json.loads(blob.decode("utf-8-sig", "replace")), out)
            except (ValueError, RecursionError):
                _scan_text(blob, out)
    return list(out.values())


def slicer_access_codes():
    """{serial: access code} from the installed slicer."""
    return {p["serial"]: p["accessCode"]
            for p in slicer_printers() if p["accessCode"]}


def slicer_serials():
    """Serials mentioned anywhere in the slicer's files, even where nothing
    else about the printer was saved. Enough to fill a field in for someone."""
    seen = []
    for root in slicer_config_dirs():
        for _path, blob in slicer_files(root):
            for found in SERIAL_RE.findall(blob.decode("utf-8", "replace")):
                if found not in seen:
                    seen.append(found)
    return seen


# ---------------------------------------------------------------- the account
# A printer that is not on this network can still be watched: the Bambu app
# does it every day, through Bambu's own MQTT broker rather than the LAN. That
# needs the account, and Bambu Studio is already signed in to it.
BIND_URL = "https://api.bambulab.com/v1/iot-service/api/user/bind"
CLOUD_BROKER = "{region}.mqtt.bambulab.com"
CLOUD_REGIONS = ("us", "eu", "cn")
TOKEN_KEYS = ("access_token", "accesstoken", "token", "user_token",
              "bambu_token", "refresh_token")


def slicer_tokens():
    """Account tokens the slicer has stored, JWTs first, then longest."""
    found = []

    def walk(node, depth=0):
        if depth > 12:
            return
        if isinstance(node, dict):
            for key, value in node.items():
                if (str(key).lower() in TOKEN_KEYS and isinstance(value, str)
                        and len(value) > 40):
                    found.append(value.strip())
                else:
                    walk(value, depth + 1)
        elif isinstance(node, list):
            for item in node[:50]:
                walk(item, depth + 1)

    for root in slicer_config_dirs():
        for _path, blob in slicer_files(root):
            try:
                walk(json.loads(blob.decode("utf-8-sig", "replace")))
            except (ValueError, RecursionError):
                continue
    return sorted(set(found), key=lambda t: (not t.startswith("ey"), -len(t)))


def jwt_claims(token):
    """The payload of a JWT, unverified — we only want the username claim,
    which is the account's MQTT login."""
    try:
        payload = token.split(".")[1]
        payload += "=" * (-len(payload) % 4)
        return json.loads(base64.urlsafe_b64decode(payload).decode("utf-8"))
    except (IndexError, ValueError, UnicodeDecodeError):
        return {}


def cloud_username(token):
    claims = jwt_claims(token)
    for key in ("username", "preferred_username", "sub", "uid"):
        value = claims.get(key)
        if isinstance(value, str) and value:
            return value if value.startswith("u_") else f"u_{value}"
    return ""


def cloud_devices(token, url=None, timeout=10):
    """Printers bound to this account. Returns (printers, note)."""
    req = urllib.request.Request(url or BIND_URL, headers={
        "Authorization": f"Bearer {token}",
        "User-Agent": "bambu-status",
        "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = json.loads(resp.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            return [], ("the account token has expired — sign in to Bambu "
                        "Studio again and it will be picked up")
        return [], f"the account service answered {e.code}"
    except (urllib.error.URLError, OSError, ValueError) as e:
        return [], f"could not reach the account service: {type(e).__name__}"

    # Bambu has renamed these fields before, so harvest rather than assume
    out = {}
    _walk(body, out)
    printers = list(out.values())
    if not printers:
        for entry in (body.get("devices") if isinstance(body, dict) else None) or []:
            if isinstance(entry, dict):
                serial = str(entry.get("dev_id") or entry.get("dev_sn") or "")
                if looks_like_serial(serial):
                    printers.append({
                        "serial": serial, "host": "",
                        "accessCode": str(entry.get("dev_access_code") or ""),
                        "name": str(entry.get("name") or ""),
                        "model": model_from_serial(serial)})
    if not printers:
        return [], "the account answered, but named no printer we could read"
    for p in printers:
        p["token"] = token
    return printers, f"{len(printers)} printer(s) on your Bambu account"


def account_printers():
    """Try each stored token until one answers. Returns (printers, note)."""
    tokens = slicer_tokens()
    if not tokens:
        return [], "no Bambu Studio account token on this machine"
    note = ""
    for token in tokens[:3]:
        printers, note = cloud_devices(token)
        if printers:
            for p in printers:
                p["source"] = "your Bambu account"
                p["mode"] = "cloud"
            return printers, note
    return [], note


def autodetect(timeout=6.0, network=True, scan=None, incomplete=False,
               account=True):
    """Every printer this machine knows about.

    The slicer's own settings come first and need no network at all; a printer
    that is also broadcasting right now contributes its current address, which
    beats whatever the slicer last wrote down."""
    known = {}
    for p in slicer_printers():
        p["source"] = "Bambu Studio"
        known[p["serial"]] = p

    # A printer the slicer saved nothing usable about is not a dead end: it may
    # be bound to the account, which is how the Bambu app watches a printer on
    # a network this machine cannot reach.
    if account and not any(p["accessCode"] and p["host"] for p in known.values()):
        for p in account_printers()[0]:
            saved = known.get(p["serial"])
            if saved:
                saved.update({k: v for k, v in p.items()
                              if v and k in ("accessCode", "name", "token", "mode")})
                saved["source"] += " · through your Bambu account"
            else:
                known[p["serial"]] = p

    if network:
        for live in discover(timeout):
            saved = known.get(live["serial"])
            if saved:
                saved["host"] = live["host"] or saved["host"]
                saved["name"] = saved["name"] or live["name"]
                saved["source"] = "Bambu Studio · on the network now"
            else:
                live["accessCode"] = ""
                live["source"] = "on the network"
                known[live["serial"]] = live
    # Nothing announced itself and we still have no address? Look for the
    # printer directly. Held back unless asked for, or unless there is an
    # access code to confirm a find with, because it is a subnet sweep.
    homeless = [p for p in known.values() if not plausible_host(p["host"])]
    want_scan = scan if scan is not None else any(p["accessCode"] for p in homeless)
    if network and want_scan and homeless:
        taken = {p["host"] for p in known.values() if p["host"]}
        for host in scan_lan():
            if host in taken:
                continue
            matched = next((p for p in homeless
                            if p["accessCode"] and accepts(host, p["accessCode"])),
                           None)
            if matched:
                matched["host"] = host
                matched["source"] += " · found by scanning the network"
                homeless.remove(matched)
                continue
            # something is listening but cannot be confirmed without a code:
            # offer it, paired with the saved printer if there is only one
            lone = homeless[0] if len(homeless) == 1 else None
            known[f"scan:{host}"] = {
                "serial": lone["serial"] if lone else "",
                "host": host, "accessCode": "",
                "name": lone["name"] if lone else "",
                "model": lone["model"] if lone else "Bambu",
                "source": "answers on 8883, access code needed"}

    # a serial the slicer knows but nothing else about: worth offering, since
    # it is one field the user then does not have to copy off the printer
    if incomplete:
        for serial in slicer_serials():
            if serial not in known:
                known[serial] = {"serial": serial, "host": "", "accessCode": "",
                                 "name": "", "model": model_from_serial(serial),
                                 "source": "seen in Bambu Studio, nothing else saved"}

    # the ones that are ready to use first
    return sorted(known.values(),
                  key=lambda p: (not (p["host"] and p["accessCode"]), p["serial"]))


def autoconfig(network=False):
    """Write the config from what this machine already knows, if that is
    unambiguous. Returns the config it wrote, or None if it could not tell.

    This is the thing that makes a first run need no setup at all: Bambu Studio
    has the address, the serial, the access code and the name the user gave the
    printer, so there is nothing to ask them."""
    printers = autodetect(network=network)
    ready = [p for p in printers if p["host"] and p["accessCode"]]
    if len(ready) > 1:
        # more than one usable printer: prefer whichever is on this network now
        live = [p for p in ready if "network" in p.get("source", "")]
        ready = live if len(live) == 1 else ready
    if len(ready) != 1:
        # nothing reachable on the LAN, but the account may still hold a
        # printer we can watch through Bambu's own broker
        ready = [p for p in printers if p.get("mode") == "cloud" and p.get("token")]
        if len(ready) != 1:
            return None

    chosen = ready[0]
    conf = {}
    if CONF.exists():
        try:
            conf = json.loads(CONF.read_text(encoding="utf-8-sig"))
        except (OSError, ValueError):
            conf = {}
    for field in ("host", "serial", "accessCode", "token", "mode"):
        if chosen.get(field):
            conf[field] = chosen[field]
    if chosen.get("name"):
        conf["name"] = chosen["name"]      # what the user calls it in the app
    if config_problem(conf):
        return None
    try:
        CONF.parent.mkdir(parents=True, exist_ok=True)
        CONF.write_text(json.dumps(conf, indent=2), encoding="utf-8")
        os.chmod(CONF, 0o600)              # it holds a printer password
    except OSError:
        return None
    return conf


def run_once(conf, stop=None):
    global ACTIVE_MODE
    ACTIVE_MODE = "lan"
    host = conf["host"]
    serial = conf["serial"]
    # "name" in the config wins; otherwise derive it from the serial
    model = conf.get("name") or conf.get("model") or model_from_serial(serial)

    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    # the printer serves a self-signed cert with no usable chain on the LAN
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE

    raw = socket.create_connection((host, PORT), timeout=10)
    sock = ctx.wrap_socket(raw, server_hostname=host)
    sock.settimeout(KEEPALIVE + 15)

    sock.sendall(connect_packet(f"bambu-status-{os.getpid()}", "bblp", conf["accessCode"]))
    hdr = recv_exact(sock, 1)
    n = read_rlen(sock)
    body = recv_exact(sock, n)
    if hdr[0] >> 4 != 2 or len(body) < 2 or body[1] != 0:
        code = body[1] if len(body) > 1 else -1
        raise PermissionError(f"CONNACK rejected, code {code} "
                              "(bad access code or LAN mode disabled)")

    sock.sendall(subscribe_packet(f"device/{serial}/report"))
    sock.sendall(publish_packet(
        f"device/{serial}/request",
        json.dumps({"pushing": {"sequence_id": "1", "command": "pushall"}})))

    stop_cam = threading.Event()
    cam = threading.Thread(target=camera_loop,
                           args=(host, conf["accessCode"], stop_cam), daemon=True)
    cam.start()
    try:
        pump(sock, serial, model, stop)
    finally:
        # without this every reconnect leaves another camera thread and another
        # socket behind, and the widget process lives for days
        stop_cam.set()
        try:
            sock.close()
        except OSError:
            pass


def cloud_context():
    """Unlike the printer on the LAN, Bambu's broker is a real service with a
    real certificate, so this one is verified."""
    return ssl.create_default_context()


def cloud_connect(conf, region, timeout=15):
    """One attempt at Bambu's broker for that region. Returns a live socket."""
    token = conf.get("token") or ""
    user = conf.get("cloudUser") or cloud_username(token)
    if not token or not user:
        raise PermissionError("no usable Bambu account token")

    host = CLOUD_BROKER.format(region=region)
    ctx = cloud_context()
    raw = socket.create_connection((host, PORT), timeout=timeout)
    sock = ctx.wrap_socket(raw, server_hostname=host)
    sock.settimeout(KEEPALIVE + 15)
    try:
        sock.sendall(connect_packet(f"bambu-status-{os.getpid()}", user, token))
        hdr = recv_exact(sock, 1)
        n = read_rlen(sock)
        body = recv_exact(sock, n)
        if hdr[0] >> 4 != 2 or len(body) < 2 or body[1] != 0:
            code = body[1] if len(body) > 1 else -1
            raise PermissionError(f"{host} rejected the account, code {code}")
    except Exception:
        sock.close()
        raise
    return sock


def run_once_cloud(conf, stop=None):
    """Watch the printer through the Bambu account instead of the LAN.

    Same MQTT, same topics, same reports, so everything from pump() down is
    shared with the LAN path. What is not shared is the camera: that protocol
    only exists on the printer's own network."""
    global ACTIVE_MODE
    serial = conf["serial"]
    model = conf.get("name") or conf.get("model") or model_from_serial(serial)
    ACTIVE_MODE = "cloud"

    regions = [conf["region"]] if conf.get("region") else list(CLOUD_REGIONS)
    sock, used, last = None, "", None
    for region in regions:
        try:
            sock, used = cloud_connect(conf, region), region
            break
        except (PermissionError, OSError) as e:
            last = e                    # the wrong region rejects the login too
    if sock is None:
        raise last or ConnectionError("no Bambu region answered")

    conf["region"] = used               # remember which one worked
    try:
        sock.sendall(subscribe_packet(f"device/{serial}/report"))
        sock.sendall(publish_packet(
            f"device/{serial}/request",
            json.dumps({"pushing": {"sequence_id": "1", "command": "pushall"}})))
        pump(sock, serial, model, stop)
    finally:
        try:
            sock.close()
        except OSError:
            pass


def pump(sock, serial, model, stop=None):
    """Read reports until the connection goes quiet or stop is set."""
    merged = {}
    last_ping = last_pushall = last_msg = time.time()
    while not (stop is not None and stop.is_set()):
        now = time.time()
        if now - last_ping > KEEPALIVE - 15:
            sock.sendall(bytes([0xC0, 0x00]))
            last_ping = now
        # the printer only sends deltas; ask for a full report periodically
        if now - last_pushall > 300:
            sock.sendall(publish_packet(
                f"device/{serial}/request",
                json.dumps({"pushing": {"sequence_id": "1", "command": "pushall"}})))
            last_pushall = now

        # a half-open TCP connection stays readable-but-silent forever, so
        # silence is the only symptom: poke it, then give up and reconnect
        quiet = now - last_msg
        if quiet > 60 and now - last_pushall > 20:
            sock.sendall(publish_packet(
                f"device/{serial}/request",
                json.dumps({"pushing": {"sequence_id": "1", "command": "pushall"}})))
            last_pushall = now
        if quiet > 180:
            raise ConnectionError(f"silent for {int(quiet)}s — reconnecting")

        if CMD.exists():
            pump_commands(sock, serial, merged)

        sock.settimeout(2)
        try:
            hdr = recv_exact(sock, 1)
        except socket.timeout:
            continue

        n = read_rlen(sock)
        body = recv_exact(sock, n) if n else b""
        if hdr[0] >> 4 != 3:          # only care about PUBLISH
            continue

        tlen = struct.unpack(">H", body[:2])[0]
        payload = body[2 + tlen:]
        try:
            msg = json.loads(payload.decode("utf-8", "replace"))
        except json.JSONDecodeError:
            continue

        last_msg = time.time()
        p = msg.get("print")
        if not isinstance(p, dict):
            continue
        merged.update(p)               # reports are partial, accumulate them
        write_state(snapshot(merged, model))


def camera_loop(host, code, stop_flag):
    """Bambu's LAN camera is a bespoke TLS stream on 6000: an 80-byte auth
    blob, then repeating 16-byte headers followed by one JPEG each."""
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    delay = 5
    while not stop_flag.is_set():
        try:
            raw = socket.create_connection((host, CAM_PORT), timeout=10)
            sock = ctx.wrap_socket(raw, server_hostname=host)
            sock.settimeout(15)
            sock.sendall(struct.pack("<IIII", 0x40, 0x3000, 0, 0)
                         + b"bblp".ljust(32, b"\x00")
                         + code.encode().ljust(32, b"\x00"))
            delay = 5
            while not stop_flag.is_set():
                hdr = recv_exact(sock, 16)
                size = int.from_bytes(hdr[:4], "little")
                if not 1000 < size < 12_000_000:
                    raise ValueError(f"implausible frame size {size}")
                jpeg = recv_exact(sock, size)
                tmp = FRAME.with_name(f".{FRAME.name}.{os.getpid()}.tmp")
                tmp.write_bytes(jpeg)
                atomic_replace(tmp, FRAME)
            sock.close()
        except Exception:
            time.sleep(delay)
            delay = min(delay * 2, 60)


def reprint_payload(merged):
    """Rebuild the start-print command for the job the printer last ran.

    The printer needs the 3mf path on its own storage; the report only gives
    gcode_file, so fall back to the task name when that is not a 3mf."""
    gfile = merged.get("gcode_file") or ""
    name = merged.get("subtask_name") or ""
    base = os.path.basename(gfile)
    if not base.endswith(".3mf"):
        base = f"{name}.gcode.3mf" if name else ""
    if not base:
        return None
    return {"print": {
        "sequence_id": "3",
        "command": "project_file",
        "param": "Metadata/plate_1.gcode",
        "url": f"file:///sdcard/{base}",
        "subtask_name": name,
        "bed_type": "auto",
        "timelapse": False,
        "bed_leveling": True,
        "flow_cali": False,
        "vibration_cali": True,
        "layer_inspect": False,
        "use_ams": False,
        "profile_id": "0", "project_id": "0",
        "subtask_id": "0", "task_id": "0",
    }}


def pump_commands(sock, serial, merged):
    """Forward a verb the applet wrote into the command file, then clear it."""
    try:
        verb = CMD.read_text(encoding="utf-8").strip()
    except OSError:
        return
    try:
        CMD.unlink()
    except OSError:
        pass
    if verb not in ALLOWED_COMMANDS:
        return

    if verb == "reprint":
        payload = reprint_payload(merged)
        if payload is None:
            return
    else:
        payload = {"print": {"sequence_id": "2", "command": verb}}

    sock.sendall(publish_packet(f"device/{serial}/request", json.dumps(payload)))


def single_instance():
    """Take the monitor lock, or return None if another process holds it.

    A second connection is wasteful and both instances would fight over the
    status file. The Windows widget calls this to decide whether it has to run
    the monitor itself, so this reports rather than exits."""
    DIR.mkdir(parents=True, exist_ok=True)
    try:
        lock = open(LOCK, "a+")
    except OSError:
        return None
    try:
        if os.name == "nt":
            import msvcrt
            lock.seek(0)
            msvcrt.locking(lock.fileno(), msvcrt.LK_NBLCK, 1)
        else:
            import fcntl
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock.close()
        return None
    return lock                      # keep the handle alive for the process life


def transport(conf):
    """The LAN when there is a printer to reach on it, the account otherwise."""
    mode = str(conf.get("mode") or "auto").lower()
    if mode == "cloud":
        return run_once_cloud
    if mode == "lan":
        return run_once
    lan_ready = (plausible_host(conf.get("host"))
                 and plausible_code(conf.get("accessCode")))
    return run_once if lan_ready else run_once_cloud


def serve(conf, stop=None):
    """Stay connected to the printer until stop is set. Returns an exit code."""
    delay = 5
    while not (stop is not None and stop.is_set()):
        try:
            transport(conf)(conf, stop)
        except PermissionError as e:
            write_state({}, connected=False, error=str(e))
            return 2                   # bad credentials — retrying is pointless
        except Exception as e:
            write_state({}, connected=False, error=f"{type(e).__name__}: {e}")
            if stop is not None:
                stop.wait(delay)
            else:
                time.sleep(delay)
            delay = min(delay * 2, 60)
        else:
            delay = 5
    return 0


# ---------------------------------------------------------------- doctor
def mask(secret):
    secret = str(secret or "")
    if not secret:
        return "(not set)"
    return f"{secret[:2]}…{secret[-1:]} ({len(secret)} chars)"


def probe(host, code, timeout=6):
    """Walk the connection the way the monitor does, reporting each step.

    Every failure looks different from the outside: a refused socket is a wrong
    address or LAN mode being off, a rejected CONNACK is the access code."""
    out = []
    try:
        start = time.time()
        raw = socket.create_connection((host, PORT), timeout=timeout)
        out.append(f"    TCP {host}:{PORT} … open ({int((time.time() - start) * 1000)} ms)")
    except OSError as e:
        out.append(f"    TCP {host}:{PORT} … {type(e).__name__}: {e}")
        out.append("      -> wrong address, printer off, or LAN mode disabled")
        return out
    sock = None
    try:
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        sock = ctx.wrap_socket(raw, server_hostname=host)
        sock.settimeout(timeout)
        out.append("    TLS handshake … ok")
    except OSError as e:
        out.append(f"    TLS handshake … {type(e).__name__}: {e}")
        out.append("      -> something answers on 8883, but it is not a printer")
        return out
    try:
        sock.sendall(connect_packet(f"doctor-{os.getpid()}", "bblp", code))
        hdr = recv_exact(sock, 1)
        n = read_rlen(sock)
        body = recv_exact(sock, n)
        if hdr[0] >> 4 == 2 and len(body) > 1 and body[1] == 0:
            out.append("    MQTT login … accepted — this config works")
        else:
            rc = body[1] if len(body) > 1 else -1
            out.append(f"    MQTT login … rejected (code {rc})")
            out.append("      -> wrong access code for this printer" if rc in (4, 5)
                       else "      -> the printer refused the login")
    except OSError as e:
        out.append(f"    MQTT login … {type(e).__name__}: {e}")
    finally:
        try:
            sock.close()
        except (OSError, AttributeError):
            pass
    return out


def looks_secret(key):
    k = str(key).lower()
    return any(w in k for w in ("code", "password", "passwd", "token", "secret",
                                "key", "auth"))


def show(key, value):
    """Values are printed to be pasted into a bug report, so anything that
    could be a credential is reduced to its shape."""
    text = str(value)
    if looks_secret(key):
        return mask(text)
    if looks_like_serial(text):
        return text[:6] + "…" + f" ({len(text)} chars)"
    return text[:48] + ("…" if len(text) > 48 else "")


def _dump_walk(node, trail, rows, depth=0):
    if depth > 12 or len(rows) > 120:
        return
    if isinstance(node, dict):
        flat = {str(k).lower(): v for k, v in node.items()}
        # a dict is worth showing if it names a device or holds an access code
        notable = any(k in flat for k in CODE_KEYS + ID_KEYS + IP_KEYS + NAME_KEYS)
        if notable:
            fields = {k: show(k, v) for k, v in node.items()
                      if isinstance(v, (str, int, float))}
            rows.append((trail or "(root)", fields))
        for key, value in node.items():
            _dump_walk(value, f"{trail}.{key}" if trail else str(key), rows, depth + 1)
    elif isinstance(node, list):
        for i, item in enumerate(node[:20]):
            _dump_walk(item, f"{trail}[{i}]", rows, depth + 1)


def deep_scan(root, limit=6000):
    """Any file at all holding something shaped like a Bambu serial.

    The key-name search only finds layouts we already know; this one finds the
    file regardless of what the fields are called, or whether it is even JSON."""
    hits = []
    seen = 0
    for path in root.rglob("*"):
        if seen >= limit or len(hits) >= 20:
            break
        try:
            if not path.is_file() or path.stat().st_size > 4_000_000:
                continue
            blob = path.read_bytes()
        except OSError:
            continue
        seen += 1
        found = SERIAL_RE.findall(blob.decode("utf-8", "replace"))
        if found:
            hits.append((path, sorted(set(found))[:4], blob))
    return hits, seen


def context_json(node, needles, trail="", out=None, depth=0):
    """Where the serial sits in a parsed config, and what sits beside it."""
    out = [] if out is None else out
    if depth > 12 or len(out) > 12:
        return out
    if isinstance(node, dict):
        for key, value in node.items():
            here = f"{trail}.{key}" if trail else str(key)
            hit_key = any(n in str(key) for n in needles)
            hit_val = isinstance(value, (str, int, float)) and \
                any(n in str(value) for n in needles)
            if hit_key and isinstance(value, dict):
                out.append((here, {k: show(k, v) for k, v in value.items()
                                   if isinstance(v, (str, int, float))}))
            elif hit_key or hit_val:
                out.append((trail or "(root)",
                            {k: show(k, v) for k, v in node.items()
                             if isinstance(v, (str, int, float))}))
            context_json(value, needles, here, out, depth + 1)
    elif isinstance(node, list):
        for i, item in enumerate(node[:40]):
            context_json(item, needles, f"{trail}[{i}]", out, depth + 1)
    return out


def context_text(blob, needles):
    """For a file that is not JSON: the bytes around the serial, with anything
    code-shaped blanked out."""
    text = blob.decode("utf-8", "replace")
    out = []
    for needle in needles[:2]:
        at = text.find(needle)
        if at < 0:
            continue
        window = text[max(0, at - 120):at + 160].replace("\n", " ")
        out.append(re.sub(r"\b[0-9a-zA-Z]{8}\b", "********", window))
    return out


def cmd_dump(args):
    """--dump-slicer: show how this machine's slicer stores its printers.

    Every version has arranged these files differently, so when the importer
    comes up empty this is what says why. Credentials are masked."""
    print("Bambu Status — slicer config dump\n")
    dirs = slicer_config_dirs()
    if not dirs:
        print("  no Bambu Studio or OrcaSlicer directory for this user")
        return 1
    total = 0
    for root in dirs:
        print(f"  {root}")
        for path, blob in slicer_files(root):
            try:
                data = json.loads(blob.decode("utf-8-sig", "replace"))
            except ValueError:
                continue
            rows = []
            _dump_walk(data, "", rows)
            if not rows:
                continue
            total += 1
            print(f"    {path.relative_to(root)}")
            if isinstance(data, dict):
                print(f"      top-level keys: {', '.join(list(data)[:12])}")
            for trail, fields in rows[:8]:
                shown = ", ".join(f"{k}={v}" for k, v in list(fields.items())[:10])
                print(f"      {trail}: {shown}")
    if total:
        return 0

    print("\n  No file names a printer by address or access code.")
    print("  Looking for a serial number in every file instead…")
    anything = False
    for root in dirs:
        hits, seen = deep_scan(root)
        print(f"    {root}  ({seen} files read)")
        for path, serials, blob in hits[:4]:
            anything = True
            print(f"      {path.relative_to(root)}: "
                  + ", ".join(s[:6] + "…" for s in serials))
            try:
                rows = context_json(json.loads(blob.decode("utf-8-sig", "replace")),
                                    serials)
            except ValueError:
                rows = []
            if rows:
                for trail, fields in rows[:6]:
                    shown = ", ".join(f"{k}={v}" for k, v in
                                      list(fields.items())[:12])
                    print(f"        {trail}: {shown}")
            else:
                for window in context_text(blob, serials):
                    print(f"        …{window}…")
    if anything:
        print("\n  Those files know the printer. Send this output — the importer"
              "\n  can be taught to read them.")
    else:
        print("\n  Nothing anywhere. This slicer has only ever reached the"
              "\n  printer through the Bambu cloud, which keeps no LAN"
              "\n  credentials on disk, so there is nothing here to import."
              "\n  Enter the access code once from the printer's own screen"
              "\n  (Settings → WLAN) and it will be remembered from then on.")
    return 0


def cmd_doctor(args):
    """--doctor: say exactly where the chain breaks."""
    print("Bambu Status — doctor")
    print()
    print(f"  config: {CONF} {'exists' if CONF.exists() else 'MISSING'}")
    conf = {}
    if CONF.exists():
        try:
            conf = json.loads(CONF.read_text(encoding="utf-8-sig"))
        except ValueError as e:
            print(f"    unreadable: {e}")
    if conf:
        print(f"    host       {conf.get('host') or '(not set)'}")
        print(f"    serial     {conf.get('serial') or '(not set)'}")
        print(f"    accessCode {mask(conf.get('accessCode'))}")
        print(f"    name       {conf.get('name') or '(not set)'}")
    print(f"    verdict    {config_problem(conf) or 'usable'}")

    print()
    print("  Bambu Studio / OrcaSlicer:")
    dirs = slicer_config_dirs()
    if not dirs:
        print("    no slicer config directory found for this user")
    for root in dirs:
        hits = [str(f.relative_to(root)) for f, _ in slicer_files(root)]
        print(f"    {root}")
        if hits:
            print(f"      {len(hits)} file(s) hold device fields, e.g. "
                  + ", ".join(hits[:6]))
        else:
            print("      no file holds an address, serial or access code")

    printers = slicer_printers()
    print(f"    printers read out of them: {len(printers)}")
    for p in printers:
        print(f"      {p['model']}  {p['host'] or 'no address'}  {p['serial']}  "
              f"code {mask(p['accessCode'])}  name {p['name'] or '-'}")

    print()
    print("  your Bambu account:")
    tokens = slicer_tokens()
    if not tokens:
        print("    no account token saved by Bambu Studio — sign in to it, and"
              " the printer can be watched without being on its network")
    else:
        who = cloud_username(tokens[0])
        print(f"    token found: {mask(tokens[0])}, account {who or 'unknown'}")
        if "--offline" in args:
            print("    not asking the account service (--offline)")
        else:
            printers, note = account_printers()
            print(f"    {note}")
            for p in printers:
                print(f"      {p['model']}  {p['serial']}  "
                      f"code {mask(p['accessCode'])}  name {p['name'] or '-'}")

    print()
    print("  network:")
    if "--offline" in args:
        print("    skipped (--offline)")
    else:
        live = discover(timeout=6.0)
        print(f"    listened on {SSDP_PORTS} for 6 s — {len(live)} printer(s) announced")
        for p in live:
            print(f"      {p['model']}  {p['host']}  {p['serial']}")
        if not live:
            print("      nothing heard: another network, LAN mode off, or a "
                  "firewall is blocking UDP 2021")
            print(f"    scanning {', '.join(n + '.0/24' for n in local_subnets())} "
                  f"for port {PORT}…")
            open_hosts = scan_lan()
            if open_hosts:
                print(f"      {len(open_hosts)} address(es) answer on {PORT}: "
                      + ", ".join(open_hosts[:8]))
                print("      one of those is the printer — LAN mode is on")
            else:
                print("      nothing on this network answers on 8883 at all,"
                      " which means LAN mode is off or the printer is elsewhere")

    host = conf.get("host") or next((p["host"] for p in printers if p["host"]), "")
    code = conf.get("accessCode") or next((p["accessCode"] for p in printers
                                           if p["accessCode"]), "")
    print()
    print("  connection:")
    if not host or str(host) in PLACEHOLDERS:
        print("    no address to try on the LAN")
    else:
        for line in probe(host, code):
            print(line)

    token = conf.get("token") or (tokens[0] if tokens else "")
    serial = conf.get("serial") or ""
    if token and looks_like_serial(serial) and "--offline" not in args:
        print("    through the account:")
        for region in CLOUD_REGIONS:
            try:
                sock = cloud_connect({"token": token, "serial": serial}, region)
                sock.close()
                print(f"      {CLOUD_BROKER.format(region=region)} … accepted"
                      " — the printer can be watched from here")
                break
            except PermissionError as e:
                print(f"      {CLOUD_BROKER.format(region=region)} … {e}")
            except OSError as e:
                print(f"      {CLOUD_BROKER.format(region=region)} … "
                      f"{type(e).__name__}")

    print()
    print("  last state written by the monitor:")
    try:
        print("    " + OUT.read_text(encoding="utf-8")[:400])
    except OSError:
        print(f"    {OUT} does not exist — the monitor has never run")
    return 0


def describe(printers):
    for i, p in enumerate(printers, 1):
        print(f"  {i}. {p['model']:>8}  {p['host'] or 'address unknown':<15} "
              f"{p['serial']}  access code: "
              f"{'known' if p['accessCode'] else 'not saved'}  ({p['source']})")


def cmd_detect(args):
    """--detect: what this machine knows about, from the slicer and the LAN."""
    printers = autodetect(network="--offline" not in args)
    if not printers:
        print("No printers found. Bambu Studio has none saved and nothing "
              "announced itself on the network.")
        return 1
    print(f"{len(printers)} printer(s):")
    describe(printers)
    return 0


def cmd_setup(args):
    """--setup [n]: write the config from what was found."""
    printers = autodetect(network="--offline" not in args)
    ready = [p for p in printers if p["host"] and p["accessCode"]]
    pick = next((int(a) for a in args if a.isdigit()), None)
    if pick is not None:
        if not 1 <= pick <= len(printers):
            print(f"There is no printer {pick}.")
            describe(printers)
            return 1
        chosen = printers[pick - 1]
    elif len(ready) == 1:
        chosen = ready[0]
    else:
        print("Pick one with --setup <number>:" if printers
              else "Nothing found to set up.")
        describe(printers)
        return 1

    problem = config_problem(chosen)
    if problem:
        print(f"Not enough to go on: {problem}")
        return 1
    conf = {}
    if CONF.exists():
        try:
            conf = json.loads(CONF.read_text(encoding="utf-8-sig"))
        except ValueError:
            pass
    conf.update({k: chosen[k] for k in ("host", "serial", "accessCode")})
    CONF.parent.mkdir(parents=True, exist_ok=True)
    CONF.write_text(json.dumps(conf, indent=2), encoding="utf-8")
    try:
        os.chmod(CONF, 0o600)          # it holds a printer password
    except OSError:
        pass
    print(f"Wrote {CONF} for the {chosen['model']} at {chosen['host']}.")
    return 0


def main():
    args = sys.argv[1:]
    if "--help" in args or "-h" in args:
        print(__doc__.strip())
        print("\n  --doctor [--offline]     say where the connection breaks"
              "\n  --dump-slicer            show how the slicer stores its printers"
              "\n  --detect [--offline]     list printers this machine knows of"
              "\n  --setup [n] [--offline]  write the config from one of them"
              "\n  (no arguments)           run the monitor")
        return 0
    if "--dump-slicer" in args:
        return cmd_dump(args)
    if "--doctor" in args:
        return cmd_doctor(args)
    if "--detect" in args:
        return cmd_detect(args)
    if "--setup" in args:
        return cmd_setup(args)

    lock = single_instance()
    if lock is None:
        print("bambu-monitor already running", file=sys.stderr)
        return 0
    conf = {}
    if CONF.exists():
        try:
            conf = json.loads(CONF.read_text(encoding="utf-8-sig"))
        except ValueError as e:
            write_state({}, connected=False, error=f"bad config: {e}")
            return 1
    problem = config_problem(conf)
    if problem:
        # nothing usable on file: work it out from Bambu Studio and the LAN
        found = autoconfig(network=True)
        if found is None:
            write_state({}, connected=False,
                        error=f"{problem} — or run bambu-monitor --setup")
            return 1
        conf = found
    return serve(conf)


if __name__ == "__main__":
    sys.exit(main())
